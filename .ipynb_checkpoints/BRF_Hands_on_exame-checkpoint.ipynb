   "source": [
    "def is_palindrome(word):\n",
    "    cleaned_word = ''.join(word.split()).lower()\n",
    "    return cleaned_word == cleaned_word[::-1]\n",
    "\n",
    "print(is_palindrome(\"madam\"))\n",
    "print(is_palindrome(\"dog\"))"
   ]
  }
